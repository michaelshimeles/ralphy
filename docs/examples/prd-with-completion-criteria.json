  "userStories": [
    {
      "id": "AUTH-1",
      "title": "Implement JWT authentication",
      "description": "Create JWT token generation and validation logic",
      "platforms": ["api"],
      "files": ["src/auth/jwt.ts", "tests/auth/jwt.test.ts"],
      "acceptanceCriteria": [
        "JWT tokens are generated with proper claims",
